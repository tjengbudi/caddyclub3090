# Optional API key for the proxy on :80.
#
#   empty / absent  -> the proxy is open to anyone who can reach the port
#   set             -> every request must carry the key, as either
#                        Authorization: Bearer <key>
#                      or
#                        x-api-key: <key>
#
# Manage it with `llmroute key set|generate|clear|show` — no restart needed.
PROXY_KEY=

# GID of the host's docker group, so the router container can read
# /var/run/docker.sock. Get it with:  getent group docker | cut -d: -f3
# It changes when docker-ce is reinstalled — update it and run
# `docker compose up -d` again.
DOCKER_GID=988
